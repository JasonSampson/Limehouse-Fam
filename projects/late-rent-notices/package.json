{
  "name": "late-rent-notices",
  "version": "1.0.0",
  "private": true,
  "description": "Automated 14-day late rent notice tool for Limehouse Property Management. Drafts notices from Buildium ledger data; a human PM (or, under strict limits, Jason as fallback decision-maker) reviews and sends.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "migrate": "node-pg-migrate",
    "migrate:up": "node-pg-migrate up",
    "migrate:down": "node-pg-migrate down",
    "job:daily": "tsx src/jobs/runDailyLatenessCheck.ts",
    "job:escalation": "tsx src/jobs/runEscalationCheck.ts",
    "job:reminder": "tsx src/jobs/runPmReminderCheck.ts",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:db": "vitest run --config vitest.config.db.ts",
    "test:all": "npm run test && npm run test:db"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "jose": "^5.9.0",
    "pg": "^8.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "node-pg-migrate": "^7.6.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.9"
  }
}
