{
  "name": "limehq",
  "version": "1.0.0",
  "private": true,
  "description": "LimeHQ — the shared login and permissions front door for every Limehouse Property Management tool (Dashboard, Late Rent Notices, and future modules). Staff sign in here once and launch into whichever project they're permitted to use.",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--use-system-ca tsx watch src/server.ts",
    "start": "cross-env NODE_OPTIONS=--use-system-ca tsx src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "migrate": "node-pg-migrate",
    "migrate:up": "node-pg-migrate up",
    "migrate:down": "node-pg-migrate down",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "helmet": "^8.3.0",
    "jose": "^5.9.0",
    "pg": "^8.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "cross-env": "^10.1.0",
    "node-pg-migrate": "^7.6.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.9"
  }
}
