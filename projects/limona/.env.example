# Copy to .env. Never commit .env.

# --- Postgres ---
# This project uses its OWN standalone database — do NOT point this at
# late-rent-notices' or limehouse-dashboard's database. Every project in this
# repo gets its own database by convention.
# You will need Postgres with the "pgvector" extension available (used to
# store and search document embeddings). If you're not sure whether your
# Postgres has it, ask whoever set up your server, or use a managed Postgres
# provider that offers pgvector (e.g. Supabase, Neon, or a self-hosted
# instance with the pgvector extension installed).
DATABASE_URL=postgres://limona_app:CHANGE_ME@localhost:5432/limona

NODE_ENV=development
PORT=3200

# --- Session ---
# Random string, 32+ chars recommended. Signs the login session cookie.
# Generate with: openssl rand -hex 32
SESSION_COOKIE_SECRET=CHANGE_ME

# --- Anthropic (Claude API) ---
# Required for the chat feature to generate answers. Without this, the app
# still runs and admin document management still works, but staff will see
# a "not fully set up yet" message instead of an answer when they ask a
# question.
# Get a key at: https://console.anthropic.com/ (Settings -> API Keys)
ANTHROPIC_API_KEY=

# --- Embeddings ---
# No API key needed. Embeddings (turning uploaded documents and staff
# questions into something searchable) run fully on this machine using a
# small local model (@xenova/transformers) — no account, no external
# service, no per-query cost. The first time you upload a document or ask a
# question, it downloads the model file once (a few seconds) and caches it
# locally on disk; every run after that is instant.

# --- File storage ---
# Where uploaded original documents are stored on disk (relative to the
# project folder unless you give an absolute path). This is what makes
# "download the exact original file" always possible — the original bytes
# never touch the database, only this folder.
STORAGE_DIR=storage
