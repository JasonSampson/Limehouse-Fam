# Copy to .env. Never commit .env.

# --- Postgres ---
# This project uses its OWN standalone database — do NOT point this at
# late-rent-notices' database. Jason decided against sharing a database
# between the two projects for now.
DATABASE_URL=postgres://limehouse_dashboard_app:CHANGE_ME@localhost:5432/limehouse_dashboard

# REQUIRED — must be exactly "production" on a real deploy. Gates the
# dev-login admin bypass and the session cookie's secure flag (see
# src/config/env.ts's own comment), so this is NOT a value to leave at its
# local-dev default when copying this file for a real deployment. Local
# development should override this to "development" in its own .env.
NODE_ENV=production
PORT=3100

# --- Buildium ---
# This must be a FRESH API key, separate from the one late-rent-notices
# uses, so it can be revoked independently. Generate one in Buildium under
# Settings -> Open API / Developer Portal.
BUILDIUM_CLIENT_ID=CHANGE_ME
BUILDIUM_CLIENT_SECRET=CHANGE_ME
BUILDIUM_BASE_URL=https://api.buildium.com/v1

# --- RentEngine (optional) ---
# Leave blank until Jason confirms RentEngine offers API access for this
# account. The app runs fine without it — the Leasing/Marketing tiles that
# depend on RentEngine will show as "not connected" instead of breaking.
# CONFIRMED LIVE 2026-07-03 against Jason's real RentEngine account: the
# real base URL is https://app.rentengine.io/api/public/v1 — the
# api.rentengine.com/v1 guess used here previously does not exist (every
# call against it would have 404'd/failed to resolve had a key ever been
# set). Auth is Bearer <key>, which was already correct.
RENTENGINE_API_KEY=
RENTENGINE_BASE_URL=https://app.rentengine.io/api/public/v1
# Required for the /calls and /messages endpoints (Total Calls / Outbound
# Texts tiles) — confirmed fixed per account in real data.
RENTENGINE_ACCOUNT_ID=

# --- LeadSimple (optional) ---
# Leave blank until Jason confirms LeadSimple API access for reading staff
# performance data (separate from the write-only stub in late-rent-notices).
# CONFIRMED LIVE 2026-07-05: the real base URL is api.leadsimple.com/rest —
# api.leadsimple.com/v1 (the previous default here) 404s on every path and
# was never actually reachable. Verified independently against /users,
# /process_types, /processes, /tasks (all real 200s with real account data).
LEADSIMPLE_API_KEY=
LEADSIMPLE_BASE_URL=https://api.leadsimple.com/rest

# --- App session ---
# Random string, 32+ chars recommended. Signs the session cookie issued after
# a successful Microsoft sign-in. Generate with: openssl rand -hex 32
SESSION_COOKIE_SECRET=CHANGE_ME

# --- LimeHQ handoff (staff login) ---
# FIXED 2026-07-30: this file used to document a direct Microsoft Entra SSO
# integration (ENTRA_TENANT_ID/CLIENT_ID/CLIENT_SECRET/REDIRECT_URI) that
# was never actually implemented — login was reworked to a handoff-token
# flow from LimeHQ instead (see src/auth/session.ts), and this template was
# never updated to match. Anyone provisioning a new deployment from the old
# version of this file would have configured the wrong integration
# entirely. LIMEHQ_HANDOFF_SECRET must match HANDOFF_TOKEN_SECRET in
# LimeHQ's own .env exactly.
LIMEHQ_HANDOFF_SECRET=CHANGE_ME
LIMEHQ_URL=http://localhost:3300
