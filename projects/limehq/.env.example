# Copy to .env. Never commit .env.

# --- Postgres ---
DATABASE_URL=postgres://limehq_app:CHANGE_ME@localhost:5432/limehq

# --- Server ---
PORT=3300
NODE_ENV=development

# --- Session & handoff secrets ---
# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# SESSION_COOKIE_SECRET and HANDOFF_TOKEN_SECRET must be different values.
SESSION_COOKIE_SECRET=CHANGE_ME_min_32_chars
HANDOFF_TOKEN_SECRET=CHANGE_ME_min_32_chars_and_different_from_session_secret

# --- Handoff target URLs (optional — leave blank if app is not yet deployed) ---
# LimeHQ redirects to {URL}/auth/limehq-callback?token=... when a staff member
# clicks a tile. The receiving app verifies the token and issues its own session.
LATE_RENT_NOTICES_URL=
DASHBOARD_URL=

# --- Map module (native module, not a handoff target — see src/map/) ---
# Connection string for the `map_staff_app` Postgres role created by
# Limehouse-Fam/projects/map's migration 0010_create_roles_and_grants.ts
# (search_path=map, read access to every internal Map table, write access
# scoped to map.property_exclusions and map.named_area_exclusions). That
# migration creates the role with a placeholder password
# ('CHANGE_ME_AT_DEPLOY') — Scotty must rotate it to a real secret before
# this is used against production data. Leave blank in a dev environment
# that doesn't have Map's schema/roles provisioned; the Map tile simply
# won't appear on the launcher and /map shows a "not configured" page
# instead of crashing the whole app.
MAP_DATABASE_URL=postgresql://map_staff_app:CHANGE_ME@aws-1-us-east-2.pooler.supabase.com:5432/postgres

# Google Maps JavaScript API key (Maps JS + Places + drawing libraries),
# loaded client-side on /map. Safe to expose in page source by design —
# restrict it by HTTP-referrer allowlist in Google Cloud Console (add
# LimeHQ's real domain) rather than relying on secrecy. Can reuse the same
# key already confirmed live in Limehouse-Fam/projects/map/.env.
GOOGLE_MAPS_API_KEY=

# Supabase Storage — used only server-side (src/map/photoUrls.ts) to mint
# short-lived signed URLs for property photos. SUPABASE_SERVICE_ROLE_KEY
# must never be sent to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
